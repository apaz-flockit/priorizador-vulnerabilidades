# Clave de la API de Anthropic (https://console.anthropic.com). Sin ella, la app funciona solo con reglas.
ANTHROPIC_API_KEY=
# Modelo de Claude a usar (opcional)
ANTHROPIC_MODEL=claude-haiku-4-5
# Código de acceso opcional: si lo definís, el análisis con IA lo pide (evita que terceros gasten tu clave). Elegí uno propio y no lo subas al repo.
ACCESS_CODE=
