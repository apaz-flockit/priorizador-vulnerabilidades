# Clave de la API de Anthropic (https://console.anthropic.com). Sin ella, la app funciona solo con reglas.
ANTHROPIC_API_KEY=
# Modelo de Claude a usar (opcional)
ANTHROPIC_MODEL=claude-sonnet-4-5
# Código de acceso opcional: si lo definís, el análisis con IA lo pide (evita que terceros gasten tu clave)
ACCESS_CODE=
